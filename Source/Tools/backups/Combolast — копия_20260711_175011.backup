        <input type="range" id="sl-stamswing" min="0" max="100" step="1" value="17">
      </div>
      <div class="row">
        <div class="row-head"><label>Сила отбрасывания</label><span class="val" id="vl-kbforce">20</span></div>
        <input type="range" id="sl-kbforce" min="0" max="40" step="0.5" value="20">
