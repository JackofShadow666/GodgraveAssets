        <input type="range" id="sl-blockSlowDur" min="0.1" max="2" step="0.1" value="0.6">
      </div>
      <div class="row">
        <div class="row-head"><label>Замедл. при блоке (x)</label><span class="val" id="vl-blockSlowMult">0.5</span></div>
        <input type="range" id="sl-blockSlowMult" min="0.1" max="1" step="0.05" value="0.5">
      </div>
      <div class="row">
        <div class="row-head"><label>Откл. меча при блоке мин°</label><span class="val" id="vl-deflectMin">50</span></div>
        <input type="range" id="sl-deflectMin" min="0" max="90" step="1" value="50">
      </div>
      <div class="row">
        <div class="row-head"><label>Откл. меча при блоке макс°</label><span class="val" id="vl-deflectMax">100</span></div>
        <input type="range" id="sl-deflectMax" min="5" max="180" step="1" value="100">
      </div>
      <div class="row">
        <div class="row-head"><label>Меч сзади: буст скор.</label><span class="val" id="vl-swordback">0.55</span></div>
        <input type="range" id="sl-swordback" min="0.3" max="1.0" step="0.05" value="0.4">
      </div>
      <div class="row">
        <div class="row-head"><label style="color:#cc8020;">Блок-откат сила</label><span class="val" id="vl-blockKB" style="color:#cc8020;">5</span></div>
        <input type="range" id="sl-blockKB" min="0" max="20" step="0.5" value="5" style="accent-color:#cc6010;">
      </div>
    </div>

    <!-- БЛОК: BLADE BIND -->
    <div class="sec">
      <div class="sec-title" style="color:#9a6a20;">█ BLADE BIND</div>
      <div class="row" style="flex-direction:row;align-items:center;gap:7px;">
        <input type="checkbox" id="cb-bbind" style="accent-color:#ccaa30;cursor:pointer;" checked>
        <label for="cb-bbind" style="font-size:8px;color:#8a7020;cursor:pointer;letter-spacing:0.5px;">Включить Blade Bind</label>
      </div>
      <div class="row">
        <div class="row-head"><label style="color:#8a7020;">Bladebind: окно (сек)</label><span class="val" id="vl-bbwindow" style="color:#ccaa30;">1.2</span></div>
        <input type="range" id="sl-bbwindow" min="0.3" max="3.0" step="0.1" value="1.2" style="accent-color:#ccaa30;">
      </div>
      <div class="row">
        <div class="row-head"><label style="color:#8a7020;">Шанс выбить оружие %</label><span class="val" id="vl-disarmchance" style="color:#ccaa30;">30</span></div>
        <input type="range" id="sl-disarmchance" min="0" max="100" step="1" value="30" style="accent-color:#ccaa30;">
      </div>
      <div class="row" style="flex-direction:row;align-items:center;gap:7px;">
        <input type="checkbox" id="cb-orbitdet" style="accent-color:#cc5020;cursor:pointer;" checked>
