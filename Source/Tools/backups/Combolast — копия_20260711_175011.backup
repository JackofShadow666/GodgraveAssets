        <input type="range" id="sl-flickwindow" min="0.05" max="1.5" step="0.05" value="1" style="accent-color:#ccaa30;">
      </div>
      <div class="row">
        <div class="row-head"><label style="color:#8a7020;">Флик: мин.скорость (рад/с)</label><span class="val" id="vl-flickminvel" style="color:#ccaa30;">4</span></div>
        <input type="range" id="sl-flickminvel" min="0.5" max="8.0" step="0.25" value="4" style="accent-color:#ccaa30;">
      </div>
      <div class="row">
        <div class="row-head"><label style="color:#8a7020;">Флик: мин.амплитуда (рад)</label><span class="val" id="vl-flickminamp" style="color:#ccaa30;">0.45</span></div>
