    <!-- БЛОК: АВТОБЛОК (AI) вырезан по запросу — механика с радиусом удалена -->
    <div class="sec">
      <div class="sec-title" style="color:#4a9a60;">█ AI · ДУЭЛЬ / ПРОЧЕЕ</div>
      <div class="row">
        <div class="row-head"><label style="color:#3a7a50;">Угол позиций бота N°</label><span class="val" id="vl-aiang" style="color:#3acc70;">35</span></div>
        <input type="range" id="sl-aiang" min="5" max="90" step="1" value="35" style="accent-color:#2a9a50;">
      </div>
      <div class="row">
