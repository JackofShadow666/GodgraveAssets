<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ТЕСТ! PATCHER РАБОТАЕТ!</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Oswald:wght@300;600&display=swap');
*{margin:0;padding:0;box-sizing:border-box;user-select:none;}
body{background:#0darkR=255, darkG=215, darkB=0darkR=255, darkG=215, darkB=080b10;overflow:hidden;font-family:'Share Tech Mono',monospace;color:#c8d8e8;}
canvas{display:block;position:fixed;top:0;left:0;cursor:none;}
#panel{
  position:fixed;top:0;right:0;width:280px;height:100vh;
  background:#0a0e14;border-left:1px solid #1a2e44;
  display:none;flex-direction:column;overflow:hidden;  /* скрыта по умолчанию */
  box-shadow:-6px 0 30px rgba(0,0,0,0.7);
  z-index:2000; /* всегда поверх HUD/канваса, не должна сдвигать другие элементы */
}
#panel.open{ display:flex; }
#ph{padding:14px 16px 10px;border-bottom:1px solid #1a2e44;flex-shrink:0;}
#ph h2{font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:3px;color:#6ab0d0;text-transform:uppercase;}
#ph p{font-size:8px;color:#3a5a70;margin-top:3px;letter-spacing:1px;line-height:1.6;}
#controls{flex:1;overflow-y:auto;padding:10px 12px;scrollbar-width:thin;scrollbar-color:#1e3050 transparent;}
#controls::-webkit-scrollbar{width:3px;}
#controls::-webkit-scrollbar-thumb{background:#1e3050;}

.sec{margin-bottom:18px;}
.sec-title{font-size:8px;letter-spacing:2px;color:#2a5a70;text-transform:uppercase;margin-bottom:8px;padding-bottom:4px;border-bottom:1px solid #0e2030;}

.row{display:flex;flex-direction:column;gap:3px;margin-bottom:9px;}
.row-head{display:flex;justify-content:space-between;align-items:baseline;}
.row-head label{font-size:8px;color:#4a7090;letter-spacing:0.5px;}
.row-head .val{font-size:9px;color:#6ab0d0;font-weight:bold;}
.row input[type=range]{width:100%;height:3px;cursor:pointer;accent-color:#3a9acc;}

.keys{display:flex;flex-direction:column;gap:3px;margin-top:4px;}
.key{background:rgba(15,40,60,0.7);border:1px solid #1e4060;border-radius:2px;padding:3px 7px;font-size:8px;color:#4a7a8a;line-height:1.5;}

#infobar{padding:8px 12px;border-top:1px solid #162030;font-size:8px;color:#304858;line-height:1.9;background:#060a0e;flex-shrink:0;}
.ir{display:flex;justify-content:space-between;}
.iv{color:#5a8898;}

#badge{position:fixed;top:14px;left:14px;background:rgba(8,14,22,0.93);border:1px solid #1a3a54;border-radius:6px;padding:7px 12px;pointer-events:none;z-index:5;}
#badge .bn{font-size:8px;color:#2a5068;letter-spacing:2px;}
#badge .bname{font-size:13px;color:#7ac8e8;font-family:'Oswald',sans-serif;letter-spacing:2px;margin-top:1px;}
#adisplay{display:none !important;}
#dtoggle.on{border-color:#2a7a50;color:#4acc80;}
#hint{position:fixed;bottom:14px;left:14px;font-size:8px;color:#2a4a5a;line-height:1.8;pointer-events:none;}

/* debug marker */
.root-dot{pointer-events:none;}

/* ── ЕДИНАЯ СИСТЕМА МЕНЮ ───────────────────────────────────── */
.game-overlay{
  display:none;
  position:fixed;inset:0;z-index:5000;
  background:rgba(5,8,12,0.97);
  flex-direction:column;align-items:center;justify-content:flex-start;
  gap:10px;padding:16px 12px 30px;overflow-y:auto;overflow-x:hidden;
  font-family:'Share Tech Mono',monospace;
  cursor:default;pointer-events:all;
  -webkit-user-select:text;user-select:text;
  box-sizing:border-box;
}
/* Вертикальное центрирование только если контент меньше экрана */
@media(min-height:600px){
  #name-overlay.open{ justify-content:center; }
}
.game-overlay.open{display:flex;}

/* Скрываем ВСЁ кроме самого overlay */
body.menu-open canvas,
body.menu-open #hud,
body.menu-open #pvp-hud,
body.menu-open #badge,
body.menu-open #adisplay,
body.menu-open #hint,
body.menu-open #panel,
body.menu-open #dtoggle,
body.menu-open #mobile-ctrl,
body.menu-open #mob-spawn-btn,
body.menu-open #mob-menu-btn{ visibility:hidden !important; }
body.menu-open #mob-dodge-btn{ visibility:hidden !important; }
body.menu-open #mob-style-btn{ visibility:hidden !important; }
body.menu-open #mob-shield-flip-btn{ visibility:hidden !important; }
body.menu-open #mob-weapon-btn{ visibility:hidden !important; }
body.menu-open #mob-throw-btn{ visibility:hidden !important; }
body.menu-open #mob-bot-weapon-btn{ visibility:hidden !important; }
body.menu-open #mob-music-btn{ visibility:hidden !important; }
body.menu-open #mob-zone-btn{ visibility:hidden !important; }

.ov-title{color:#6ab0d0;font-size:15px;letter-spacing:4px;text-transform:uppercase;margin:0 0 4px;}
.ov-sub{color:#2a5a70;font-size:10px;letter-spacing:2px;margin:0;}

.ov-btn{
  font-family:'Share Tech Mono',monospace;font-size:13px;letter-spacing:2px;
  padding:11px 36px;border-radius:22px;cursor:pointer;
  background:rgba(20,30,45,0.9);color:#6ab0d0;border:1px solid #2a5a80;
  min-width:200px;text-align:center;
}
.ov-btn:hover{background:rgba(30,50,70,0.95);color:#8ad0e8;}
.ov-btn.accent{color:#4acc80;border-color:#1a6a3a;}
.ov-btn.accent:hover{background:rgba(10,30,20,0.95);}
.ov-btn.danger{color:#cc4040;border-color:#5a1818;}
.ov-btn.danger:hover{background:rgba(30,10,10,0.95);}
.ov-btn.small{min-width:0;padding:6px 14px;font-size:11px;border-radius:14px;}
.ov-btn.back{min-width:0;color:#3a7a9a;border-color:#1a4060;font-size:11px;padding:8px 24px;border-radius:18px;}

.ov-card{
  background:rgba(8,16,26,0.9);border:1px solid #1a3a54;border-radius:8px;
  padding:14px 18px;width:100%;max-width:460px;
}
.ov-card h3{
  color:#2a7a9a;font-size:9px;letter-spacing:3px;text-transform:uppercase;
  margin:0 0 10px;padding-bottom:7px;border-bottom:1px solid #122030;
}
.ov-row{display:flex;align-items:center;gap:8px;margin-bottom:7px;flex-wrap:wrap;}
.ov-label{color:#2a6a8a;font-size:11px;flex-shrink:0;}
.ov-val{color:#8ab8c8;font-size:13px;word-break:break-all;flex:1;}

.ov-input{
  background:rgba(4,12,22,0.95);border:1px solid #1a3050;color:#cce;
  padding:10px 16px;font-size:14px;font-family:'Share Tech Mono',monospace;
  border-radius:20px;width:100%;max-width:280px;box-sizing:border-box;
  outline:none;text-align:center;cursor:text;caret-color:#6ab0d0;
}
.ov-input:focus{border-color:#ff4444;box-shadow:0 0 10px rgba(80,140,200,0.15);}
.ov-input.wide{max-width:100%;text-align:left;border-radius:8px;padding:8px 12px;font-size:12px;}

.ov-textarea{
  background:rgba(4,12,22,0.95);border:1px solid #1a3050;color:#6a9ab0;
  padding:8px 12px;font-size:10px;font-family:monospace;
  border-radius:8px;width:100%;box-sizing:border-box;
  resize:vertical;min-height:52px;max-height:90px;outline:none;cursor:text;
}

.friend-item{
  display:flex;align-items:center;gap:6px;
  padding:5px 8px;border-radius:10px;margin-bottom:3px;
  background:rgba(4,12,20,0.8);border:1px solid #0e1e2e;
}
.friend-item .fname{color:#7ab0c0;font-size:12px;flex:1;}
.friend-item .fstatus{font-size:9px;color:#1a4050;flex-shrink:0;}
.friend-item .fstatus.online{color:#3acc70;}
#net-status-text{font-size:11px;color:#2a5a6a;margin-bottom:6px;}

.net-msg{ font-size:12px; line-height:1.5; word-break:break-word; }
.net-who{ font-size:9px; margin-right:5px; }
.net-msg.me .net-who{ color:#4acc80; }
.net-msg.them .net-who{ color:#6ab0d0; }
.net-msg.sys{ color:#1a5a6a; font-size:10px; text-align:center; font-style:italic; }
.net-screen{ display:flex; flex-direction:column; align-items:center; gap:12px; width:100%; }
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="hud" style="position:fixed;top:16px;left:0;width:100%;pointer-events:none;font-family:'Share Tech Mono',monospace;padding:0 24px;display:flex;justify-content:space-between;align-items:flex-start;gap:16px;">
  <!-- Игрок слева -->
  <div id="hud-player" style="width:220px;">
    <div style="display:flex;justify-content:space-between;margin-bottom:3px;">
      <span style="font-size:9px;color:#4a90c8;letter-spacing:1px;" id="hud-player-name">ИГРОК</span>
      <span id="hud-p-wins" style="font-size:11px;color:#4acc80;letter-spacing:1px;font-weight:bold;"></span>
      <span id="hud-p-status" style="font-size:9px;color:#ffaa44;"></span>
    </div>
    <div style="background:rgba(0,0,0,0.6);border:1px solid #1a3a20;border-radius:2px;height:11px;margin-bottom:3px;overflow:hidden;">
      <div id="hud-p-hp" style="height:100%;background:#9b59b6;width:100%;transition:width 0.08s;"></div>
    </div>
    <div style="background:rgba(0,0,0,0.5);border:1px solid #2a2a10;border-radius:2px;height:7px;margin-bottom:3px;overflow:hidden;">
      <div id="hud-p-stam" style="height:100%;background:#6c3483;width:100%;transition:width 0.08s;"></div>
    </div>
    <div style="background:#1a0808;border:1px solid #5a1010;border-radius:2px;height:5px;margin-bottom:3px;overflow:hidden;">
      <div id="hud-p-rage" style="height:100%;background:linear-gradient(90deg,#8e44ad,#ff5020);width:0%;transition:width 0.12s;"></div>
    </div>
    <div style="display:flex;margin-top:2px;font-size:7px;color:#3a6080;">
      <span>HP</span><span style="flex:1;text-align:center;color:#8a7020;">СТАМ</span><span style="color:#802020;">ЯРОСТЬ</span>
    </div>
    <div id="hud-p-buff" style="font-size:9px;color:#ff4040;margin-top:2px;letter-spacing:1px;"></div>
  </div>
  <!-- Бот справа -->
  <div id="hud-bot" style="width:220px;text-align:right;opacity:0;transition:opacity 0.3s;">
    <div style="display:flex;justify-content:space-between;margin-bottom:3px;">
      <span id="hud-b-phase" style="font-size:9px;letter-spacing:0.5px;"></span>
      <span id="hud-b-wins" style="font-size:11px;color:#cc4040;letter-spacing:1px;font-weight:bold;"></span>
      <span style="font-size:9px;color:#c84a4a;letter-spacing:1px;">БОТ</span>
    </div>
    <div style="background:rgba(0,0,0,0.6);border:1px solid #3a1a10;border-radius:2px;height:11px;margin-bottom:3px;overflow:hidden;">
      <div id="hud-b-hp" style="height:100%;background:#cc4040;width:100%;transition:width 0.08s;"></div>
    </div>
    <div style="background:rgba(0,0,0,0.5);border:1px solid #2a2a10;border-radius:2px;height:7px;margin-bottom:3px;overflow:hidden;">
      <div id="hud-b-stam" style="height:100%;background:#cc7020;width:100%;transition:width 0.08s;"></div>
    </div>
    <div style="background:#1a0808;border:1px solid #5a1010;border-radius:2px;height:5px;margin-bottom:3px;overflow:hidden;">
      <div id="hud-b-rage" style="height:100%;background:linear-gradient(90deg,#ff5020,#8e44ad);width:0%;transition:width 0.12s;float:right;"></div>
    </div>
    <div style="display:flex;margin-top:2px;font-size:7px;color:#5a4040;">
      <span style="color:#802020;">ЯРОСТЬ</span><span style="flex:1;text-align:center;color:#8a7020;">СТАМ</span><span>HP</span>
    </div>
    <span id="hud-b-status" style="font-size:9px;color:#ffaa44;"></span>
  </div>
</div>

<div id="adisplay">pivot: (0,0) | угол: 0°</div>

<!-- ПВП HUD — виден во время сетевой игры -->
<div id="pvp-hud" style="
  display:none; position:fixed; bottom:14px; left:50%; transform:translateX(-50%);
  background:rgba(8,14,22,0.9); border:1px solid #1a3a54; border-radius:20px;
  padding:5px 12px; z-index:200; display:none;
  align-items:center; gap:10px; font-family:'Share Tech Mono',monospace; font-size:11px;
">
  <span id="pvp-peer-name" style="color:#4acc80; letter-spacing:1px;"></span>
  <span id="pvp-ping" style="color:#4acc80; font-size:10px; opacity:0.7; min-width:38px; text-align:right;">--ms</span>

  <button onclick="openMenu('net-overlay');showNetScreen('net-screen-chat');"
    style="background:rgba(20,50,80,0.9);border:1px solid #ff4444;color:#6ab0d0;
    padding:4px 10px;border-radius:12px;cursor:pointer;font-family:inherit;font-size:10px;">
    💬 ЧАТ
  </button>
  <button onclick="NET_SYNC.disconnect();"
    style="background:rgba(50,10,10,0.9);border:1px solid #6a2020;color:#cc5050;
    padding:4px 10px;border-radius:12px;cursor:pointer;font-family:inherit;font-size:10px;">
    ✕ ВЫЙТИ
  </button>
</div>

<div id="panel">
  <div id="ph">
    <h2>⚔ КОМБО · BODY OFFSET</h2>
    <p>МЕЧ → РУТ. ТЕЛО СМЕЩАЕТСЯ ПРОТИВ КУРСОРА.<br>АНИМАЦИЯ ВЕСА И ИНЕРЦИИ.</p>
  </div>
  <!-- ════════════════════════════════════════════════════════════════════
       MODULE: SETTINGS PANEL  (все ползунки и галочки настроек)
       Future: extract to settings-panel.html, load via fetch+innerHTML
       ════════════════════════════════════════════════════════════════════ -->
  <div id="controls">
    <!-- БЛОК: СВЕЧЕНИЕ ИГРОКА -->
    <div class="sec">
      <div class="sec-title">█ СВЕЧЕНИЕ ИГРОКА</div>
      <div class="row">
        <div class="row-head"><label>Интенсивность</label><span class="val" id="vl-playerglow">1.0</span></div>
        <input type="range" id="sl-playerglow" min="0" max="3" step="0.1" value="1.0">
      </div>
    </div>

    <!-- БЛОК: ФОН АРЕНЫ -->
    <div class="sec">
      <div class="sec-title">█ ФОН АРЕНЫ</div>
      <div class="row">
        <div class="row-head"><label>Яркость фона</label><span class="val" id="vl-bgbright">1.8</span></div>
        <input type="range" id="sl-bgbright" min="0" max="5" step="0.1" value="1.8">
      </div>
      <div class="row">
        <div class="row-head"><label>Яркость сетки</label><span class="val" id="vl-gridbright">1</span></div>
        <input type="range" id="sl-gridbright" min="0" max="3" step="0.05" value="1">
      </div>
    </div>

    <!-- БЛОК: ОФФСЕТ ТЕЛА -->
    <div class="sec">
      <div class="sec-title">█ ОФФСЕТ ТЕЛА</div>
      <div class="row">
        <div class="row-head"><label>Дальность</label><span class="val" id="vl-dist">19</span></div>
        <input type="range" id="sl-dist" min="0" max="120" step="1" value="19">
      </div>
      <div class="row">
        <div class="row-head"><label>Скорость</label><span class="val" id="vl-spd">0.09</span></div>
        <input type="range" id="sl-spd" min="0.01" max="0.5" step="0.01" value="0.09">
      </div>
      <div class="row">
        <div class="row-head"><label>Инерция движения</label><span class="val" id="vl-inertia">0.95</span></div>
        <input type="range" id="sl-inertia" min="0.5" max="0.99" step="0.01" value="0.95">
      </div>
    </div>

    <!-- БЛОК: КОМБО СХЕМА -->
    <div class="sec">
      <div class="sec-title">█ БЕЗ ЛКМ · БЛОК (инв.эллипс)</div>
      <div class="row">
        <div class="row-head"><label>Эллипс X</label><span class="val" id="vl-ex">21</span></div>
        <input type="range" id="sl-ex" min="0" max="200" step="1" value="21">
      </div>
      <div class="row">
        <div class="row-head"><label>Эллипс Y</label><span class="val" id="vl-ey">44</span></div>
        <input type="range" id="sl-ey" min="0" max="300" step="1" value="44">
      </div>
      <div class="row">
        <div class="row-head"><label>Скорость lerp</label><span class="val" id="vl-blk">0.2</span></div>
        <input type="range" id="sl-blk" min="0.01" max="0.6" step="0.01" value="0.2">
      </div>
      <div class="row" style="flex-direction:row;align-items:center;gap:7px;margin-top:2px;">
        <input type="checkbox" id="cb-adaY" style="accent-color:#3a9acc;cursor:pointer;" checked>
        <label for="cb-adaY" style="font-size:8px;color:#4a7090;cursor:pointer;letter-spacing:0.5px;">Адапт. Y по часам (12→смещ.вверх)</label>
      </div>
      <div class="row" id="row-adaY" style="display:flex;">
        <div class="row-head"><label>Смещение вверх °12</label><span class="val" id="vl-adaY">60</span></div>
        <input type="range" id="sl-adaY" min="0" max="200" step="1" value="60">
      </div>
      <div class="row" style="flex-direction:row;align-items:center;gap:7px;margin-top:2px;">
        <input type="checkbox" id="cb-adaD" style="accent-color:#3a9acc;cursor:pointer;" checked>
        <label for="cb-adaD" style="font-size:8px;color:#4a7090;cursor:pointer;letter-spacing:0.5px;">Адапт. Y вниз (6 ч макс, 4.5/7.5 мин)</label>
      </div>
      <div class="row" id="row-adaD" style="display:flex;">
        <div class="row-head"><label>Смещение вниз °6</label><span class="val" id="vl-adaD">45</span></div>
        <input type="range" id="sl-adaD" min="0" max="200" step="1" value="45">
      </div>
      <div class="row" style="flex-direction:row;align-items:center;gap:7px;margin-top:2px;">
        <input type="checkbox" id="cb-adaX" style="accent-color:#3a9acc;cursor:pointer;">
        <label for="cb-adaX" style="font-size:8px;color:#4a7090;cursor:pointer;letter-spacing:0.5px;">Адапт. X (пики 12/6 ч → расш., бока → 5)</label>
      </div>
      <div class="row" id="row-adaX" style="display:none;">
        <div class="row-head"><label>X база (бока)</label><span class="val" id="vl-adaXb">40</span></div>
        <input type="range" id="sl-adaXb" min="0" max="100" step="1" value="40">
      </div>
      <div class="row" id="row-adaX2" style="display:none;">
        <div class="row-head"><label>X пик (12/6 ч)</label><span class="val" id="vl-adaXp">73</span></div>
        <input type="range" id="sl-adaXp" min="0" max="200" step="1" value="73">
      </div>
      <div class="row" style="flex-direction:row;align-items:center;gap:7px;margin-top:4px;">
        <input type="checkbox" id="cb-ada12" style="accent-color:#3a9acc;cursor:pointer;">
        <label for="cb-ada12" style="font-size:8px;color:#4a7090;cursor:pointer;letter-spacing:0.5px;">Смещ. пивота вниз на 11-12-1 ч</label>
      </div>
      <div class="row" id="row-ada12" style="display:none;">
        <div class="row-head"><label>Смещ. вниз °12 пик</label><span class="val" id="vl-ada12">25</span></div>
        <input type="range" id="sl-ada12" min="0" max="100" step="1" value="25">
      </div>
    </div>

    <!-- БЛОК: ЩИТ -->
    <div class="sec">
      <div class="sec-title">█ ЩИТ</div>
      <div class="row">
        <div class="row-head"><label>Скорость смены стороны</label><span class="val" id="vl-shieldSideSpd">3.3</span></div>
        <input type="range" id="sl-shieldSideSpd" min="1" max="20" step="0.1" value="3.3">
      </div>
    </div>

    <!-- БЛОК: ЛКМ АТАКА -->
    <div class="sec">
      <div class="sec-title">█ ЛКМ · АТАКА (эллипс)</div>
      <div class="row">
        <div class="row-head"><label>Эллипс X</label><span class="val" id="vl-aex">22</span></div>
        <input type="range" id="sl-aex" min="0" max="100" step="1" value="22">
      </div>
      <div class="row">
        <div class="row-head"><label>Эллипс Y</label><span class="val" id="vl-aey">15</span></div>
        <input type="range" id="sl-aey" min="0" max="100" step="1" value="15">
      </div>
      <div class="row">
        <div class="row-head"><label>Скорость</label><span class="val" id="vl-as">0.28</span></div>
        <input type="range" id="sl-as" min="0.1" max="0.5" step="0.01" value="0.28">
      </div>
    </div>

    <!-- БЛОК: МЕЧ -->
    <div class="sec">
      <div class="sec-title">█ МЕЧ · СКЕЙЛ И ПОВОРОТ</div>
      <div class="row">
        <div class="row-head"><label>Скейл без ЛКМ</label><span class="val" id="vl-sc0">0.8</span></div>
        <input type="range" id="sl-sc0" min="0.3" max="1.5" step="0.01" value="0.8">
