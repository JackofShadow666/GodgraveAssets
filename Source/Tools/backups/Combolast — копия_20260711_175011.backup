}
/* Кнопка смены оружия бота — рядом со щитом бота */
#mob-bot-weapon-btn {
  position: absolute; top: 14px; left: calc(50% - 221px);
  background: rgba(10,30,20,0.9); border: 1px solid #2a6a40; border-radius: 50%;
