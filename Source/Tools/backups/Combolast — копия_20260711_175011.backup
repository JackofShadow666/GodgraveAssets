      <div class="row">
        <div class="row-head"><label>Сопротивление меча</label><span class="val" id="vl-swres">0.85</span></div>
        <input type="range" id="sl-swres" min="0" max="1" step="0.05" value="0.85">
      </div>
      <div class="row">
        <div class="row-head"><label style="color:#4060cc;">Откат при столкн. мечей</label><span class="val" id="vl-bladeKB" style="color:#5080ff;">5</span></div>
        <input type="range" id="sl-bladeKB" min="0" max="20" step="0.5" value="5" style="accent-color:#3060cc;">
      </div>
      <div class="row">
