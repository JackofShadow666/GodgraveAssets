        <input type="range" id="sl-circchance" min="0" max="100" step="5" value="35" style="accent-color:#2a9a50;">
      </div>
      <div class="row" style="flex-direction:row;align-items:center;gap:7px;">
        <input type="checkbox" id="cb-duel" style="accent-color:#3acc70;cursor:pointer;" checked>
        <label for="cb-duel" style="font-size:8px;color:#3a8a50;cursor:pointer;letter-spacing:0.5px;">Duel Position System</label>
      </div>
      <div class="row">
        <div class="row-head"><label style="color:#3a7a50;">Длит. вращения (сек)</label><span class="val" id="vl-spindur" style="color:#3acc70;">0.8</span></div>
        <input type="range" id="sl-spindur" min="0.3" max="3.0" step="0.1" value="0.8" style="accent-color:#2a9a50;">
      </div>
      <div class="row" style="flex-direction:row;align-items:center;gap:7px;">
        <input type="checkbox" id="cb-nospin" style="accent-color:#3acc70;cursor:pointer;">
        <label for="cb-nospin" style="font-size:8px;color:#3a8a50;cursor:pointer;letter-spacing:0.5px;">Запретить вращения</label>
      </div>
      <div class="row" style="flex-direction:row;align-items:center;gap:7px;">
        <input type="checkbox" id="cb-alwaysmirror" style="accent-color:#3acc70;cursor:pointer;">
        <label for="cb-alwaysmirror" style="font-size:8px;color:#3a8a50;cursor:pointer;letter-spacing:0.5px;">Всегда Mirror стиль</label>
      </div>
    </div>

    <!-- БЛОК: БОТ -->
    <div class="sec" id="sec-mobile-cam">
      <div class="sec-title">█ СКОРОСТЬ ИГРЫ</div>
      <div class="row">
        <div class="row-head"><label>Скорость игры (x)</label><span class="val" id="vl-gamespeed">1.0</span></div>
