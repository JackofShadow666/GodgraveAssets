        <div class="row-head"><label style="color:#8a5020;">Орбита: окно (сек)</label><span class="val" id="vl-orbitwindow" style="color:#cc7040;">1.0</span></div>
        <input type="range" id="sl-orbitwindow" min="0.3" max="3.0" step="0.1" value="1.0" style="accent-color:#cc5020;">
      </div>
      <div class="row">
        <div class="row-head"><label style="color:#8a5020;">Орбита: полных оборотов</label><span class="val" id="vl-orbitturns" style="color:#cc7040;">1.0</span></div>
        <input type="range" id="sl-orbitturns" min="0.3" max="3.0" step="0.1" value="1.0" style="accent-color:#cc5020;">
      </div>
      <div class="row">
        <div class="row-head"><label style="color:#8a5020;">Орбита: стамина (потеря)</label><span class="val" id="vl-stamorbit" style="color:#cc7040;">30</span></div>
        <input type="range" id="sl-stamorbit" min="0" max="60" step="5" value="30" style="accent-color:#cc5020;">
      </div>
      <div class="row" style="flex-direction:row;align-items:center;gap:7px;">
        <input type="checkbox" id="cb-flickdet" style="accent-color:#ccaa30;cursor:pointer;" checked>
