  display: flex; align-items: center; justify-content: center;
  pointer-events: auto !important; touch-action: none;
  z-index: 1000;
}

/* Кнопка меню (⚙) — открывает оверлей с настройками поверх экрана */
#mob-menu-btn {
  position: absolute; top: 14px; left: calc(50% + 3px);
  background: rgba(10,20,30,0.9); border: 1px solid #1a4060; border-radius: 50%;
